@echo off
REM 切換編碼為 UTF-8 以解決中文亂碼
chcp 65001 > nul

echo 正在啟動 JLU 規則書網站預覽...
echo 瀏覽器將在 2 秒後自動開啟，請稍候。
echo ====================================================================
echo 【關閉說明】若要停止伺服器，請直接關閉此黑視窗，或按 Ctrl+C。
echo ====================================================================

REM 在背景倒數 2 秒後，自動使用預設瀏覽器開啟網址
start /b cmd /c "timeout /t 2 >nul & start http://127.0.0.1:8000"

REM 啟動 MkDocs 本機伺服器
mkdocs serve
pause